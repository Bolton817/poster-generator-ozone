# ==============================================================================
# Ozone Lounge Poster Generator — Environment Configuration Reference
# Stage 21: Deployment, environments and operations
# ==============================================================================
# IMPORTANT: Copy this file to .env.local for local development.
# In staging/production, configure these variables in the hosting provider dashboard.
# NEVER commit .env, .env.local, or real production secrets to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# DATABASE_URL: Transaction-pooled connection string (e.g. PgBouncer pooler on port 6543).
# Used by the runtime application to execute fast queries with connection pooling.
DATABASE_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.example-db-provider.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct, non-pooled connection string (e.g. port 5432).
# Required by Prisma CLI for migrations (prisma migrate deploy).
DIRECT_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.example-db-provider.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SESSION CONFIGURATION (Better Auth)
# ------------------------------------------------------------------------------
# AUTH_SECRET: Cryptographically secure random secret (minimum 32 characters/bytes).
# Generate via: openssl rand -hex 32
AUTH_SECRET="replace-with-a-secure-32-byte-hex-or-base64-secret"

# APP_BASE_URL: Authoritative canonical URL of the application.
# Used for server-side auth redirect resolution and session validation.
APP_BASE_URL="http://localhost:3005"

# NEXT_PUBLIC_APP_URL: Client-exposed base URL for browser API calls.
NEXT_PUBLIC_APP_URL="http://localhost:3005"

# TRUSTED_ORIGINS: Comma-separated list of allowed CORS origins for auth and API requests.
TRUSTED_ORIGINS="http://localhost:3005,https://your-staging-domain.vercel.app"

# ------------------------------------------------------------------------------
# 3. APPLICATION RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# NODE_ENV: Application environment mode ('development', 'staging', 'production').
NODE_ENV="development"

# LOG_LEVEL: Minimum operational log severity ('debug', 'info', 'warn', 'error').
# Defaults to 'info' in production, capturing auth failures, upload, and save events.
LOG_LEVEL="info"

# ------------------------------------------------------------------------------
# 4. MASTER CANVAS DIMENSION CONTRACT
# ------------------------------------------------------------------------------
# Enforces exact 1080 × 1350 px (4:5 aspect ratio) master render resolution (Decision 01).
POSTER_WIDTH="1080"
POSTER_HEIGHT="1350"

# ------------------------------------------------------------------------------
# 5. ASSET STORAGE PROVIDER CONFIGURATION (Decision 10)
# ------------------------------------------------------------------------------
# STORAGE_PROVIDER: 'local' (filesystem, development default) or 'supabase' (production).
STORAGE_PROVIDER="local"

# Local storage directory path (used when STORAGE_PROVIDER="local")
STORAGE_LOCAL_DIR="./public/uploads"

# Storage bucket name for asset persistence
STORAGE_BUCKET="ozone-poster-assets"

# Supabase Storage Credentials (required when STORAGE_PROVIDER="supabase")
# SUPABASE_URL="https://[project-ref].example-cloud.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ------------------------------------------------------------------------------
# 6. CONTAINER & BUILD CONFIGURATION
# ------------------------------------------------------------------------------
# BUILD_STANDALONE: Set to 'true' in Docker builds for standalone server bundle output.
BUILD_STANDALONE="false"
