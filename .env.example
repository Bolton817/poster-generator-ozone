# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ozone_lounge_posters?schema=public"

# Authentication Secrets
AUTH_SECRET="replace-with-a-32-byte-hex-or-base64-random-secret"
APP_BASE_URL="http://localhost:3000"

# Application Environment
NODE_ENV="development"

# Master Canvas Coordinate Standards
POSTER_WIDTH="1080"
POSTER_HEIGHT="1350"

# Asset Storage Configuration (Local filesystem default for development)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./public/uploads"
STORAGE_BUCKET="ozone-poster-assets"
